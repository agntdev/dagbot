[
  {
    "name": "new chat clears context and invites a question",
    "steps": [
      { "send": { "text": "/start" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Кто ты по национальности?" } }] },
      { "send": { "callback": "lang:set:ru" }, "expect": [{ "method": "sendMessage" }] },
      { "send": { "callback": "chat:new" }, "expect": [{ "method": "sendMessage", "payload": { "text": "Начали с чистого листа. Напиши, что хочешь обсудить." } }] }
    ]
  }
]
